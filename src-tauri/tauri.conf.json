{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PNCP MINERADOR",
  "version": "0.1.0",
  "identifier": "com.alicerce.minerador",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:9000",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "🛡️ Centro de Comando",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
"build": {
  "beforeDevCommand": "cd frontend && npm run dev",
  "beforeBuildCommand": "cd frontend && npm run build",
  "devUrl": "http://localhost:9000",
  "frontendDist": "../frontend/dist"
}
}
